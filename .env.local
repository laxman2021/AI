# Required only for the AI assistant
GROQ_API_KEY=your_groq_key
GROQ_MODEL=openai/gpt-oss-120b

## Optional alternative for a Gemini Flash implementation
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-3.6-flash
#
## Optional GitHub token. Public repos work without one.
#GITHUB_TOKEN=

# Existing backend settings
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-3.6-flash
GITHUB_TOKEN=

# Backend
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# OpenID Connect
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
OIDC_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
OIDC_REDIRECT_URI=http://localhost:4000/auth/callback

SESSION_SECRET=hash

# Only this email can open the admin dashboard
ADMIN_EMAIL=your_email@gmail.com